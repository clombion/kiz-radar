{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["site/main.ts", "site/review.ts", "tests/site/**/*.test.ts"],
  "project": ["site/**/*.ts", "tests/site/**/*.ts"],
  // the world's outlines, which no module imports: package.json's vendor script copies them into public/vendor/
  "ignoreDependencies": ["world-atlas"],
  // the pipeline's runner, which mise.toml installs: the tests' setup builds the data with it
  "ignoreBinaries": ["uv"]
}
