{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // lint/plugin.ts, the house rules, is an entry by knip's oxlint plugin (.oxlintrc.json's jsPlugins)
  "entry": ["site/main.ts", "site/review.ts", "tests/site/**/*.test.ts"],
  // tests/site/lint/ and lint/fixtures/ hold the files the house rules' tests lint, which nothing imports; one stands as
  // a test file (page.browser.test.ts), which the vitest plugin takes for an entry, and its imports resolve to nothing
  "project": ["site/**/*.ts", "tests/site/**/*.ts", "lint/**/*.ts", "!tests/site/lint/**", "!lint/fixtures/**"],
  "ignore": ["tests/site/lint/**"],
  // the world's outlines, which no module imports: package.json's vendor script copies them into public/vendor/
  "ignoreDependencies": ["world-atlas"],
  // the pipeline's runner, which mise.toml installs: the tests' setup builds the data with it
  "ignoreBinaries": ["uv"]
}
