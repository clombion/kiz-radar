{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // site/main.ts and site/review.ts, the site's, are entries by knip's Vite plugin (vite.config.ts's input), and
  // lint/plugin.ts, the house rules, by its oxlint plugin (.oxlintrc.json's jsPlugins)
  "entry": ["tests/site/**/*.test.ts"],
  // lint/fixtures/ holds the files the house rules' test lints, which nothing imports; one stands as a test file
  // (tests' page.browser.test.ts), which the vitest plugin takes for an entry, and its imports resolve to nothing
  "project": ["site/**/*.ts", "tests/site/**/*.ts", "lint/**/*.ts", "!lint/fixtures/**"],
  "ignore": ["lint/fixtures/**"],
  // the world's outlines, which no module imports: package.json's vendor script copies them into public/vendor/
  "ignoreDependencies": ["world-atlas"],
  // the pipeline's runner, which mise.toml installs: the tests' setup builds the data with it
  "ignoreBinaries": ["uv"]
}
