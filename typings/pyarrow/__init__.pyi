# The part of pyarrow (pinned in pyproject.toml) that pipeline/fare_store.py uses, typed: pyarrow ships no types.
from collections.abc import Iterator, Mapping, Sequence

class DataType: ...

class Field:
    name: str

class Schema:
    names: list[str]
    def __iter__(self) -> Iterator[Field]: ...

class Table:
    @staticmethod
    def from_pylist(mapping: Sequence[Mapping[str, object]], schema: Schema) -> Table: ...
    def to_pylist(self) -> list[dict[str, object]]: ...

def schema(fields: Sequence[Field]) -> Schema: ...
def field(name: str, type: DataType, nullable: bool = True) -> Field: ...
def struct(fields: Sequence[Field]) -> DataType: ...
def list_(value_type: DataType) -> DataType: ...
def string() -> DataType: ...
def int64() -> DataType: ...
def float64() -> DataType: ...
def bool_() -> DataType: ...
def date32() -> DataType: ...
def timestamp(unit: str, tz: str | None = None) -> DataType: ...
