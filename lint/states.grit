language js

// Written by pipeline/generate.py (mise run generate) from the keys of the states the site shows
// (pipeline/states.py). A state is compared and passed as KEY.<point>.<NAME>, which the compiler holds to the table:
// a key in quotes where one is compared (===, !==, a switch's case) or passed (a call's argument) is refused, whatever
// else the code calls by the same name. plural() takes words, not states.
pattern state_key() {
  or { JsStringLiteralExpression(), JsTemplateExpression() } as $key where {
    $key <: r"^['\"`](?:accommodation_included|adults_only|afro|after_party|ahead|all_in_one|all_levels_beginners|bachata|beach_party|boat_party|bootcamp_intensive|camping|cancelled|closed|competition|contested|couple|crew|cruise|dated|day|day_socials|description|dj|door|douceur|dress_code|ended|from|full|full_pass|given|going|gone|google|group|group_deals|in_tier|included|kiwi|kizomba|kompa|kuduro|later|listed|live_music|masterclass|maybe|mc|meals_included|media|multiple_rooms|next|none|none_found|not_looked|not_yet|now|offline|on|one|one_ticket|organisation|organiser|other|other_passes_only|package|page_empty|page_unread|partner_hotel|party|per_room|performer|person|pool_party|pre_party|priced|private_classes|promo_code|reggaeton|salsa|self_transfer|semba|shows|skipped|sold_out|stated|tarraxinha|tarraxo|taxi_dancers|teacher|themed_parties|ticket_page|transfers_shuttle|unread|urbankiz|workshop|workshops|zouk)['\"`]$",
    register_diagnostic(span=$key, message="Write a state as KEY.<point>.<NAME> (site/states.ts), held to the table.")
  }
}

or { JsCallExpression(), JsBinaryExpression(), JsCaseClause() } as $use where {
  $filename <: r".*/site/[^/]+\.ts",
  $filename <: not r"(?:.*/)?tests/.*",
  $use <: or {
    `$f($args)` where { $f <: not `plural`, $args <: some state_key() },
    or { `$a === $b`, `$a !== $b`, `$a == $b`, `$a != $b` } where { or { $a <: state_key(), $b <: state_key() } },
    JsCaseClause(test=$test) where { $test <: state_key() }
  }
}
