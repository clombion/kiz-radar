{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  // a formatter lays a file out; the order of package.json's keys is pnpm's, as Biome left it
  "sortPackageJson": false,
  // the site, its tests, the stylesheet, the JSON configs and the house rules' plugin with its fixtures (lint/): every
  // file but a folder is ignored, then those let back in
  "ignorePatterns": [
    "*",
    "!*/",
    "!/site/**",
    "!/tests/**/*.ts",
    "!/tests/**/*.tsx",
    "!/lint/**/*.ts",
    "!/lint/**/*.tsx",
    "!/public/css/**",
    "!/*.json",
    "!/*.jsonc",
    "/pnpm-lock.yaml",
    // laid out by their generators (pipeline/states.py, pipeline/drawings.py), and checked against them by
    // generate:check
    "/site/states.ts",
    "/site/drawings.ts",
    // the house rule on semicolons in JSX text: the formatter would lay out again the text the rule reads
    "/lint/fixtures/semicolons/**"
  ],
  "overrides": [
    {
      // import statements in one order, sorted across a blank line and kept together, as Biome's organizeImports held
      // them; not the house rules' fixtures, whose refused lines are marked where they stand
      "files": ["*.ts", "*.tsx"],
      "excludeFiles": ["lint/fixtures/**"],
      "options": { "sortImports": { "newlinesBetween": false } }
    },
    { "files": ["*.css"], "options": { "singleQuote": false } },
    { "files": ["*.json", "*.jsonc"], "options": { "trailingComma": "none" } }
  ]
}
