{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  // the JSON configs: oxlint lints the TypeScript (.oxlintrc.json), stylelint the stylesheet (.stylelintrc.yaml)
  "files": {
    "includes": ["*.json", "*.jsonc", "!pnpm-lock.yaml"]
  },
  // oxfmt lays these files out (.oxfmtrc.jsonc, format:site)
  "formatter": { "enabled": false },
  "linter": {
    "rules": {
      // every rule
      "preset": "all"
    }
  }
}
