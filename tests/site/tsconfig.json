{
  // The site's tests, the vitest config and the house rules' plugin (lint/), checked with the site's own rules; they are
  // run by vitest and oxlint, never emitted.
  // Their libraries' declarations aren't checked: playwright's are written for an older TypeScript.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "../..",
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [".", "../../site", "../../vitest.config.ts", "../../lint"],
  // the files the house rules' tests lint, never run, some breaking a rule on purpose: lint/tests.grit's (lint.test.ts)
  // and the plugin's (rules.test.ts)
  "exclude": ["lint", "../../lint/fixtures"]
}
