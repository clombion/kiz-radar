{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A festival's first read of its ticket page: which pass each ticket is",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "title",
    "start_date",
    "read_by",
    "prompt_version",
    "rows_at",
    "styles",
    "description",
    "passes",
    "skipped",
    "rule_quotes"
  ],
  "properties": {
    "event_id": {
      "type": "integer"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "start_date": {
      "description": "The festival's first day, which a date without a year is placed before.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "read_by": {
      "description": "agent, or the two models that agreed.",
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "const": "first-read-v4",
      "description": "A read for an older prompt means something else: it is made again (tickets.py run)."
    },
    "rows_at": {
      "description": "The 'at' of the logged read (tickets/log/<event_id>.jsonl) whose tickets this read maps; every one of them is in a tier or skipped.",
      "type": "string",
      "minLength": 1
    },
    "styles": {
      "description": "The festival's dance styles when the read was made (prices.styles), which a pass's style is one of.",
      "type": "array",
      "items": {
        "enum": [
          "kizomba",
          "zouk",
          "bachata",
          "salsa",
          "other"
        ]
      }
    },
    "description": {
      "description": "The festival's description this read was made with.",
      "type": "string"
    },
    "passes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "style",
          "label_quote",
          "group_size",
          "days",
          "includes_hotel",
          "tiers"
        ],
        "properties": {
          "kind": {
            "enum": [
              "full",
              "party",
              "day",
              "workshop",
              "package",
              "other"
            ]
          },
          "style": {
            "anyOf": [
              {
                "enum": [
                  "kizomba",
                  "zouk",
                  "bachata",
                  "salsa",
                  "other"
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "The one dance style the pass is limited to, at a festival of several; null when it covers all of them."
          },
          "label_quote": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 300
          },
          "group_size": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "days": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "includes_hotel": {
            "type": "boolean"
          },
          "tiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "keys",
                "from",
                "until",
                "quantity",
                "date_quote"
              ],
              "properties": {
                "keys": {
                  "description": "The page's tickets at this price, the one whose line is quoted first.",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "from": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^(\\d{4}-)?\\d{2}-\\d{2}$"
                },
                "until": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^(\\d{4}-)?\\d{2}-\\d{2}$"
                },
                "quantity": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "date_quote": {
                  "description": "The words that say from, until or quantity, copied from the description or from one of the tier's tickets.",
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "if": {
                "properties": {
                  "from": {
                    "type": "null"
                  },
                  "until": {
                    "type": "null"
                  },
                  "quantity": {
                    "type": "null"
                  }
                }
              },
              "then": {
                "properties": {
                  "date_quote": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "date_quote": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "minItems": 1,
      "description": "At least one: a page that sells none of the festival's passes (only hotel rooms, say) is not its ticket page."
    },
    "skipped": {
      "description": "Tickets on the page that are no pass (bootcamps, single workshops, shuttles).",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule_quotes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
