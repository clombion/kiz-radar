{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "How to read the ticket rows of one ticket site",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site",
    "hosts",
    "reseller",
    "widget",
    "visible",
    "wait",
    "open",
    "symbols",
    "row",
    "api",
    "fields"
  ],
  "$defs": {
    "field": {
      "description": "Where a row's value is: the first element matching css inside the row (the row itself when css is null), its attribute attr (its text when attr is null), and in that the first group of match (all of it when match is null). css and match may name the row's other fields as {field} and the row element's attributes as {@attr}.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "css",
        "attr",
        "match"
      ],
      "properties": {
        "css": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "attr": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "match": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "page": {
          "type": "boolean",
          "description": "Read every match on the page (joined by line) instead of the first inside the row; for values a page keeps apart from its rows, such as its script data."
        }
      }
    },
    "api_field": {
      "description": "Where a ticket's value is when the site's API gives the tickets: json, a dotted path into the ticket; page, a pattern on the festival's page (its first group); or text, a template naming dotted paths in braces (\"{price.price} € + {distributionFee} € fee\"); with match, the first group of a pattern on that value.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "json": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "json"
          ]
        },
        {
          "required": [
            "page"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ]
    }
  },
  "properties": {
    "site": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "hosts": {
      "description": "Hosts of the pages festivals link to that this recipe reads.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reseller": {
      "description": "The reseller's name when the site sells other organisers' festivals at its own prices (Kizzbee), shown with the prices; null when it sells for the organiser.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "widget": {
      "description": "When the tickets show on another address than the festival's link: in, where the pattern is looked for (the link's address, or its page's HTML); pattern; and address, the address to read, built from the match ({0}, its groups {1}…, the page's {host}). Else null.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "in",
            "pattern",
            "address"
          ],
          "properties": {
            "in": {
              "enum": [
                "address",
                "html"
              ]
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "address": {
              "type": "string",
              "pattern": "^(https://|\\{)"
            }
          }
        }
      ]
    },
    "visible": {
      "description": "true when the site refuses headless browsers.",
      "type": "boolean"
    },
    "wait": {
      "description": "Seconds to let the page settle after loading.",
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "open": {
      "description": "A CSS selector whose every match is clicked before reading, to open sections shown collapsed; else null.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "symbols": {
      "description": "What the site's currency symbols stand for, as ISO 4217 codes ({\"€\": \"EUR\"}); a currency field that finds a code needs none.",
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      }
    },
    "row": {
      "description": "A CSS selector matching each ticket on the page; null when the tickets come from the site's API.",
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "api": {
      "description": "When the site's page carries no ticket ids but its API does: id, a pattern finding the event's id in the festival's page; url, the API address with {id}; items, the dotted path to the list of tickets in its JSON. row is then null and the fields are api fields. Else null.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "url",
            "items"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://.*\\{id\\}"
            },
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "name",
        "price",
        "amount",
        "currency",
        "fee",
        "alt_price",
        "alt_amount",
        "alt_currency",
        "sold_out"
      ],
      "properties": {
        "key": {
          "description": "The ticket's id on the site, the same on every read."
        },
        "name": {},
        "price": {
          "description": "The price as the page shows it."
        },
        "amount": {
          "description": "The price as a number (1,800.00, 1.800,00 and 1800 all read as 1800)."
        },
        "currency": {
          "description": "A currency code, or a symbol listed in symbols."
        },
        "fee": {
          "description": "A booking fee the site adds to the price (\"+ €1.00 fee\"), when it shows one apart; the amount logged is the price plus this fee. Null when the price shown is what a buyer pays."
        },
        "alt_price": {
          "description": "The words that give the second price, as the page shows them; with alt_amount and alt_currency, or null with them."
        },
        "alt_amount": {
          "description": "The same price in a second currency, when the site shows one."
        },
        "alt_currency": {},
        "sold_out": {
          "description": "Sold out when this field finds anything; null for a site that hides sold-out tickets."
        }
      }
    }
  },
  "oneOf": [
    {
      "description": "the page's rows",
      "properties": {
        "row": {
          "type": "string"
        },
        "api": {
          "type": "null"
        },
        "fields": {
          "properties": {
            "key": {
              "$ref": "#/$defs/field"
            },
            "name": {
              "$ref": "#/$defs/field"
            },
            "price": {
              "$ref": "#/$defs/field"
            },
            "amount": {
              "$ref": "#/$defs/field"
            },
            "currency": {
              "$ref": "#/$defs/field"
            },
            "fee": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/field"
                }
              ]
            },
            "alt_price": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/field"
                }
              ]
            },
            "alt_amount": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/field"
                }
              ]
            },
            "alt_currency": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/field"
                }
              ]
            },
            "sold_out": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/field"
                }
              ]
            }
          }
        }
      }
    },
    {
      "description": "the site's API",
      "properties": {
        "row": {
          "type": "null"
        },
        "api": {
          "type": "object"
        },
        "fields": {
          "properties": {
            "key": {
              "$ref": "#/$defs/api_field"
            },
            "name": {
              "$ref": "#/$defs/api_field"
            },
            "price": {
              "$ref": "#/$defs/api_field"
            },
            "amount": {
              "$ref": "#/$defs/api_field"
            },
            "currency": {
              "$ref": "#/$defs/api_field"
            },
            "fee": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/api_field"
                }
              ]
            },
            "alt_price": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/api_field"
                }
              ]
            },
            "alt_amount": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/api_field"
                }
              ]
            },
            "alt_currency": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/api_field"
                }
              ]
            },
            "sold_out": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/api_field"
                }
              ]
            }
          }
        }
      }
    }
  ]
}
