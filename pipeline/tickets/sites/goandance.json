    "currency": {"page": "\"priceCurrency\":\"([A-Z]{3})\""},
    "fee": {"json": "distributionFee"},
    "alt_price": null,
    "alt_amount": null,
    "alt_currency": null,
    "sold_out": {"json": "stockLeft", "match": "^0$"}
