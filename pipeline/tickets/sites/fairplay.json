{
  "site": "fairplay",
  "hosts": [
    "www.fairplay.events",
    "fairplay.events"
  ],
  "reseller": null,
  "widget": null,
  "visible": true,
  "wait": 12,
  "open": null,
  "symbols": {
    "€": "EUR"
  },
  "row": "div:has(> h4.mantine-Title-root):has(label[for^='ticketTypes.'])",
  "api": null,
  "fields": {
    "key": {
      "css": "label[for^='ticketTypes.']",
      "attr": "for",
      "match": "^ticketTypes\\.\\d+\\.(\\d+)$"
    },
    "name": {
      "css": "h4",
      "attr": null,
      "match": null
    },
    "price": {
      "css": "p[data-size='lg']",
      "attr": null,
      "match": "Price: (.+)"
    },
    "amount": {
      "css": "p[data-size='lg']",
      "attr": null,
      "match": "([\\d.,]+)"
    },
    "currency": {
      "css": "p[data-size='lg']",
      "attr": null,
      "match": "Price: ([A-Z]{3})"
    },
    "fee": null,
    "alt_price": {
      "css": "p[data-size='sm']",
      "attr": null,
      "match": "The ticket price is [\\d.,]+ €\\.?"
    },
    "alt_amount": {
      "css": "p[data-size='sm']",
      "attr": null,
      "match": "The ticket price is ([\\d.,]+) €"
    },
    "alt_currency": {
      "css": "p[data-size='sm']",
      "attr": null,
      "match": "The ticket price is [\\d.,]+ (€)"
    },
    "sold_out": null
  }
}
