{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extraction output: artists and features per event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch",
    "events"
  ],
  "properties": {
    "batch": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "artists",
          "features"
        ],
        "properties": {
          "event_id": {
            "type": "integer"
          },
          "artists": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name_as_written",
                "role",
                "style",
                "country",
                "source_line"
              ],
              "properties": {
                "name_as_written": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "$ref": "#/$defs/role"
                },
                "style": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "country": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "source_line": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "feature",
                "quote",
                "rationale"
              ],
              "properties": {
                "feature": {
                  "$ref": "#/$defs/feature"
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "rationale": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          }
        }
      }
    }
  }
}
