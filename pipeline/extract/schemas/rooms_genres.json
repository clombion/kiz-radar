{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rooms and genres per event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch",
    "events"
  ],
  "properties": {
    "batch": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "party_rooms",
          "class_rooms",
          "rooms",
          "genres"
        ],
        "properties": {
          "event_id": {
            "type": "integer"
          },
          "party_rooms": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count",
                  "quote"
                ],
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              }
            ]
          },
          "class_rooms": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "count",
                  "quote"
                ],
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              }
            ]
          },
          "rooms": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name_as_written",
                "kind",
                "genres",
                "quote"
              ],
              "properties": {
                "name_as_written": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "$ref": "#/$defs/room_kind"
                },
                "genres": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/genre"
                  }
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          },
          "genres": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "genre",
                "genre_as_written",
                "quote"
              ],
              "properties": {
                "genre": {
                  "$ref": "#/$defs/genre"
                },
                "genre_as_written": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    }
  }
}
