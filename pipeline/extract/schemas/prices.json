{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pass prices per event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batch",
    "events"
  ],
  "properties": {
    "batch": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "passes",
          "rule_quotes"
        ],
        "properties": {
          "event_id": {
            "type": "integer"
          },
          "passes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "style",
                "label_quote",
                "group_size",
                "days",
                "includes_hotel",
                "tiers"
              ],
              "properties": {
                "kind": {
                  "$ref": "#/$defs/pass_kind"
                },
                "style": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/style"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The one dance style the pass is limited to, at a festival of several; null when it covers all of them."
                },
                "label_quote": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "group_size": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "days": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "includes_hotel": {
                  "type": "boolean"
                },
                "tiers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "amount",
                      "currency",
                      "fee",
                      "alt",
                      "from",
                      "until",
                      "quantity",
                      "door",
                      "sold_out",
                      "current",
                      "quote"
                    ],
                    "properties": {
                      "amount": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "currency": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$"
                      },
                      "fee": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "exclusiveMinimum": 0
                      },
                      "alt": {
                        "description": "The same price in a second currency, when the line gives one.",
                        "anyOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "amount",
                              "currency"
                            ],
                            "properties": {
                              "amount": {
                                "type": "number",
                                "exclusiveMinimum": 0
                              },
                              "currency": {
                                "type": "string",
                                "pattern": "^[A-Z]{3}$"
                              }
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "from": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^(\\d{4}-)?\\d{2}-\\d{2}$"
                      },
                      "until": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^(\\d{4}-)?\\d{2}-\\d{2}$"
                      },
                      "quantity": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "door": {
                        "type": "boolean"
                      },
                      "sold_out": {
                        "type": "boolean"
                      },
                      "current": {
                        "type": "boolean"
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                }
              }
            }
          },
          "rule_quotes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      }
    }
  }
}
