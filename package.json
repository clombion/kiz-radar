{
  "name": "kiz-radar-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "rm -rf docs/js && tsc -p .",
    "types": "tsc --noEmit -p . && tsc -p tests/site",
    "lint": "biome check --error-on-warnings",
    "knip": "knip",
    "test": "vitest run",
    "dup": "jscpd"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.19.1",
    "@types/sql.js": "1.4.11",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "jscpd": "4.0.5",
    "knip": "6.43.0",
    "playwright": "1.56.1",
    "sql.js": "1.10.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
