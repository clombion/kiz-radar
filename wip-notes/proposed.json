{
  "reportDescriptionlessDisables": true,
  "reportNeedlessDisables": true,
  "reportInvalidScopeDisables": true,
  "plugins": ["stylelint-browser-compat"],
  "rules": {
    "at-rule-no-unknown": true, "block-no-empty": true, "custom-property-no-missing-var-function": true,
    "declaration-block-no-duplicate-custom-properties": true, "declaration-block-no-duplicate-properties": true,
    "declaration-block-no-shorthand-property-overrides": true, "declaration-no-important": true,
    "font-family-no-duplicate-names": true, "font-family-no-missing-generic-family-keyword": true,
    "function-linear-gradient-no-nonstandard-direction": true, "function-no-unknown": true,
    "keyframe-block-no-duplicate-selectors": true, "keyframe-declaration-no-important": true,
    "media-feature-name-no-unknown": true, "media-type-no-deprecated": true, "named-grid-areas-no-invalid": true,
    "no-duplicate-at-import-rules": true, "no-duplicate-selectors": true, "no-empty-source": true,
    "no-invalid-position-at-import-rule": true, "no-irregular-whitespace": true, "property-no-unknown": true,
    "selector-anb-no-unmatchable": true, "selector-pseudo-class-no-unknown": true,
    "selector-pseudo-element-no-unknown": true, "selector-type-no-unknown": true, "unit-no-unknown": true,

    "annotation-no-unknown": true, "at-charset-rule-no-invalid": true, "at-rule-descriptor-no-unknown": true,
    "at-rule-descriptor-value-no-unknown": true, "at-rule-no-deprecated": true, "at-rule-prelude-no-invalid": true,
    "block-no-redundant-nested-style-rules": true, "color-no-invalid-hex": true, "comment-no-empty": true,
    "declaration-property-value-keyword-no-deprecated": true, "declaration-property-value-no-unknown": true,
    "function-calc-no-unspaced-operator": true, "media-feature-name-value-no-unknown": true,
    "media-query-no-invalid": true, "nesting-selector-no-missing-scoping-root": true,
    "no-invalid-double-slash-comments": true, "no-invalid-position-declaration": true, "no-unknown-animations": true,
    "no-unknown-custom-media": true, "property-no-deprecated": true, "selector-no-deprecated": true,
    "selector-no-invalid": true, "selector-no-unmatchable": true, "string-no-newline": true,
    "syntax-string-no-invalid": true, "value-no-invalid": true,

    "at-rule-no-vendor-prefix": true, "media-feature-name-no-vendor-prefix": true, "property-no-vendor-prefix": true,
    "selector-no-vendor-prefix": true, "value-no-vendor-prefix": true,
    "declaration-block-no-redundant-longhand-properties": true, "shorthand-property-no-redundant-values": true,
    "color-hex-length": "short", "color-named": ["never", { "ignoreProperties": ["/^mask/"] }],
    "font-weight-notation": "numeric", "length-zero-no-unit": true, "number-max-precision": 4,
    "alpha-value-notation": "number", "color-function-notation": "modern", "color-function-alias-notation": "without-alpha",
    "hue-degree-notation": "angle", "lightness-notation": "percentage", "import-notation": "string",
    "media-feature-range-notation": "prefix", "selector-not-notation": "complex",
    "selector-pseudo-element-colon-notation": "double", "selector-attribute-quotes": "always",
    "function-url-quotes": "never", "function-url-scheme-allowed-list": ["data"],
    "display-notation": "short", "keyframe-selector-notation": "percentage-unless-within-keyword-only-block",
    "selector-type-case": "lower", "function-name-case": "lower", "comment-whitespace-inside": "always",
    "time-min-milliseconds": 100,
    "selector-class-pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
    "custom-property-pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
    "keyframes-name-pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
    "max-nesting-depth": 0, "selector-max-class": 4, "selector-max-compound-selectors": 4,

    "plugin/browser-compat": true
  }
}
